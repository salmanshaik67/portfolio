# Optional. Any endpoint that accepts a JSON POST of { name, email, message }.
# Example: https://formspree.io/f/your-form-id
# Leave empty and the contact form opens the visitor's email app instead (mailto fallback).
VITE_CONTACT_ENDPOINT=

# Optional overrides for the location and contact email shown on the site.
VITE_LOCATION=
VITE_EMAIL=
